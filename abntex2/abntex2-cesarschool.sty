% ---
% Ata de defesa
%   usar \imprimiratadefesa* casodeseje imprimir algo no verso da
%   página no caso de estar no modo twoside. Util para imprimir a Ficha
%   Bibliografica. Porem, se estiver no modo oneside, a versao sem estrela
%   é identica.
\newenvironment{atadefesa}[1][\atadefesaname]{\clearpage\PRIVATEbookmarkthis{#1}}{\cleardoublepage}
\newenvironment{atadefesa*}[1][\atadefesaname]{\clearpage\PRIVATEbookmarkthis{#1}}{\newpage}%

% ---
% Conteudo padrao da Folha de Rosto
\makeatletter
\newcommand{\atadefesacontent}{
  \begin{center}

    %\vspace*{1cm}
       { \ABNTEXchapterfont\fontsize{12}{12}\selectfont\imprimirautor 
    }
	
    \vspace*{\fill}\vspace*{\fill}
    \begin{center}
      \ABNTEXchapterfont\bfseries\Large\imprimirtitulo
    \end{center}
    \vspace*{\fill}
	
    \abntex@ifnotempty{\imprimirpreambulo}{%
      \hspace{.45\textwidth}
      \hfill\begin{minipage}{.5\textwidth}
      	\SingleSpacing
         \imprimirpreambulo
       \end{minipage}%
       \vspace*{\fill}
    }%

    {\abntex@ifnotempty{\imprimirinstituicao}{\imprimirinstituicao\vspace*{\fill}}}

    {\large\imprimirorientadorRotulo~\imprimirorientador\par}
    \abntex@ifnotempty{\imprimircoorientador}{%
       {\large\imprimircoorientadorRotulo~\imprimircoorientador}%
    }%
    \vspace*{\fill}

    {\large\imprimirlocal}
    \par
    {\large\imprimirdata}
    \vspace*{1cm}

  \end{center}
}
\makeatother

\newcommand{\imprimiratadefesastar}[1]{%
  \begin{atadefesa*}{#1}
     \atadefesacontent
  \end{atadefesa*}}

\newcommand{\imprimiratadefesanostar}[1]{%
  \begin{atadefesa}{#1}
     \atadefesacontent
  \end{atadefesa}}

\makeatletter
\newcommand{\imprimiratadefesa}[1][\atadefesaname]{%
   \@ifstar
     \imprimiratadefesastar  
     \imprimiratadefesanostar
}
\makeatother
