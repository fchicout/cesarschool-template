    \preambulo{{\trabalhoname}apresentada ao {\programaname} da {\instituicaoname}, como requisito parcial para obtenção do título de {\novatitulacao}em {\curso}.}%
    \renewcommand{\preambuloatadefesa}[1]{{\trabalhoname}apresentada ao {\programaname} da {\instituicaoname}, como requisito parcial para a obtenção do título de {\novatitulacao}em {\curso}.}%
    \renewcommand{\placeholdertitulo}{\uppercase{\textbf{Título do seu trabalho: }Subtítulo :)}}%
    \renewcommand{\placeholderautor}{\uppercase{Insira aqui seu nome completo}}%
    \renewcommand{\fautorname}{Elaborado pelo autor.}%
    \renewcommand{\fpesquisaname}{Dados de pesquisa.}%
    \renewcommand{\fadapt}{Adaptado de }%
    \renewcommand{\contentlangdir}{pt-br}%
  }%
}

