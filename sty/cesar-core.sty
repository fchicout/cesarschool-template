% ------------------------------------------------------------------------------
% Configurações de Tipografia e Fontes ABNT NBR 14724
% ------------------------------------------------------------------------------
\ifPDFTeX
  \renewcommand{\ABNTEXchapterfont}{\sffamily}
\else
  \renewcommand{\ABNTEXchapterfont}{\fontspec{Liberation Sans}}
\fi
\renewcommand{\ABNTEXchapterfontsize}{\bfseries\normalsize}
\renewcommand{\ABNTEXsectionfont}{\ABNTEXchapterfont}
\renewcommand{\ABNTEXsectionfontsize}{\normalsize\selectfont}
\renewcommand{\ABNTEXsubsectionfont}{\ABNTEXsectionfont}
\renewcommand{\ABNTEXsubsectionfontsize}{\bfseries\normalsize\selectfont}
\renewcommand{\ABNTEXsubsubsectionfont}{\itshape\ABNTEXsubsectionfont}
\renewcommand{\ABNTEXsubsubsectionfontsize}{\normalsize}
\renewcommand{\ABNTEXsubsubsubsectionfontsize}{\itshape\bfseries\normalsize}

% Ajuste de espaçamento do sumário
\setlength{\cftbeforechapterskip}{0em}
\renewcommand{\cftchapterfont}{\bfseries\normalsize}
\renewcommand{\cftchapterpagefont}{\cftchapterfont}
\renewcommand{\cftsectionfont}{\normalsize}
\renewcommand{\cftsectionpagefont}{\cftsectionfont}
\renewcommand{\cftsubsectionfont}{\bfseries\normalsize}
\renewcommand{\cftsubsectionpagefont}{\cftsubsectionfont}
\renewcommand{\cftsubsubsectionfont}{\itshape\normalsize}
\renewcommand{\cftsubsubsectionpagefont}{\itshape\cftsubsubsectionfont}
\renewcommand{\cftparagraphfont}{\itshape\bfseries}
\renewcommand{\cftparagraphpagefont}{\bfseries\cftparagraphfont}

% Converte títulos de seções no sumário para maiúsculas
\makeatletter
\let\oldcontentsline\contentsline
\def\contentsline#1#2{%
	\expandafter\ifx\csname l@#1\endcsname\l@section
	\expandafter\@firstoftwo
	\else
	\expandafter\@secondoftwo
	\fi
	{%
		\oldcontentsline{#1}{\MakeTextUppercase{#2}}%
	}{%
		\oldcontentsline{#1}{#2}%
	}%
}
\makeatother

% Espaçamentos nativos do memoir
\setlength{\afterchapskip}{0.85cm}
\setbeforesecskip{0.85cm}
\setaftersecskip{0.64cm}
\setbeforesubsecskip{0.85cm}
\setaftersubsecskip{0.64cm}
\setbeforesubsubsecskip{0.85cm}
\setaftersubsubsecskip{0.64cm}
\setbeforeparaskip{0.85cm}
\setafterparaskip{0.64cm}

